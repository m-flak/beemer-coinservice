[Unit]
Description=coinservice ({{ coinservice_environment }})
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User={{ coinservice_user }}
Group={{ coinservice_group }}
WorkingDirectory={{ coinservice_deploy_dir }}
EnvironmentFile=/etc/coinservice/{{ coinservice_environment }}/env
ExecStartPre=/bin/bash -c 'az login --service-principal \
  --username $AZURE_CLIENT_ID \
  --password $AZURE_CLIENT_SECRET \
  --tenant $AZURE_TENANT_ID \
  --output none'
ExecStart={{ coinservice_java_executable }} {{ coinservice_jvm_opts }} -jar {{ coinservice_deploy_dir }}/{{ coinservice_jar_name }}
ExecStopPost=/bin/bash -c 'az logout --output none || true'
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier={{ coinservice_service_name }}
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
